# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf
design/decor/*.glb filter=lfs diff=lfs merge=lfs -text
design/decor/*.png filter=lfs diff=lfs merge=lfs -text
design/decor/*.jpg filter=lfs diff=lfs merge=lfs -text
design/decor/**/*.glb filter=lfs diff=lfs merge=lfs -text
design/decor/**/*.png filter=lfs diff=lfs merge=lfs -text
design/decor/**/*.jpg filter=lfs diff=lfs merge=lfs -text
design/textures/*.png filter=lfs diff=lfs merge=lfs -text
