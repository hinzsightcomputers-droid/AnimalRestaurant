		{ "event": "eating_chat", "id": "evaroo_chat_notebook", "priority": 200, "conditions": { "stage": 3 }, "set": { "notebook_chat": true }, "text": "I write songs. Like, a lot. We've never played one. Only covers.", "emotion": "shy",
