				{ "tone": "straight", "text": "Why not play them?", "reply": "Covers are safe. They're somebody else's feelings. Mine are... a lot.", "emotion": "sad", "change": 3 },
				{ "tone": "rude", "text": "Probably for the best.", "reply": "(He closes the notebook and doesn't open it again.)", "emotion": "neutral", "change": -10 }
			]
		},
		{ "event": "eating_chat", "id": "evaroo_chat_bear", "priority": 200, "conditions": { "stage": 3 }, "set": { "bear_chat": true }, "text": "People are jerks to that bear with the patches. I sat next to him at the park yesterday. Didn't say anything. Just sat there. ...Don't tell anyone.", "emotion": "shy" },
		{ "event": "eating_chat", "id": "evaroo_befriends_stitches", "priority": 230, "conditions": { "min_stage": 3, "regular_min_relationship": { "stitches": 50 }, "friends_with": { "stitches": false } }, "befriends": "stitches", "set": { "bear_chat": true }, "text": "People are jerks to that bear with the patches. I sat next to him at the park yesterday. Didn't say anything. Just sat there. ...Don't tell anyone.", "emotion": "shy" },
