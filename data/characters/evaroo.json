		{ "event": "eating_chat", "id": "evaroo_chat_scared", "priority": 200, "conditions": { "stage": 3 }, "set": { "scared_chat": true }, "text": "You ever make something and get scared to show anyone? ...Forget I asked.", "emotion": "shy" },
