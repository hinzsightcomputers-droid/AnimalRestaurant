[gd_resource type="Resource" script_class="CookRecipe" format=3]

[ext_resource type="Script" path="res://scripts/cooking/cook_recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/cooking/cook_action.gd" id="2_action"]
[ext_resource type="Script" path="res://scripts/cooking/actions/roll_action.gd" id="3_roll"]
[ext_resource type="Script" path="res://scripts/cooking/actions/cut_action.gd" id="4_cut"]
[ext_resource type="Script" path="res://scripts/cooking/actions/top_action.gd" id="5_top"]
[ext_resource type="Script" path="res://scripts/cooking/actions/bake_action.gd" id="6_bake"]
[ext_resource type="PackedScene" path="res://scenes/cooking/cookie_closeup.tscn" id="7_scene"]

[sub_resource type="Resource" id="Resource_roll"]
script = ExtResource("3_roll")
title = "Roll the dough"
hint = "Hold [grip] and roll the pin across the dough with [stick]. It stretches the way you roll: fill the dashed square."

[sub_resource type="Resource" id="Resource_cut"]
script = ExtResource("4_cut")
title = "Cut the cookies"
hint = "Move the cutter with [stick] and press [button] to cut. Keep them on the dough and apart!"

[sub_resource type="Resource" id="Resource_top"]
script = ExtResource("5_top")
title = "Add the acorns"
hint = "Press [button] to put an acorn right in the middle of each cookie."
weight = 0.7

[sub_resource type="Resource" id="Resource_bake"]
script = ExtResource("6_bake")
title = "Bake"
hint = "Press [button] to take them out when they're golden!"
weight = 1.3

[resource]
script = ExtResource("1_recipe")
display_name = "Acorn Cookies"
pieces = 6
serve_on = "Tray"
scene = ExtResource("7_scene")
steps = Array[ExtResource("2_action")]([SubResource("Resource_roll"), SubResource("Resource_cut"), SubResource("Resource_top"), SubResource("Resource_bake")])
