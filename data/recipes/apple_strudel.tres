[gd_resource type="Resource" script_class="CookRecipe" format=3]

[ext_resource type="Script" path="res://scripts/cooking/cook_recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/cooking/cook_action.gd" id="2_action"]
[ext_resource type="Script" path="res://scripts/cooking/actions/roll_action.gd" id="roll"]
[ext_resource type="Script" path="res://scripts/cooking/actions/cut_action.gd" id="cut"]
[ext_resource type="Script" path="res://scripts/cooking/actions/fill_action.gd" id="fill"]
[ext_resource type="Script" path="res://scripts/cooking/actions/cover_action.gd" id="cover"]
[ext_resource type="Script" path="res://scripts/cooking/actions/bake_action.gd" id="bake"]
[ext_resource type="PackedScene" path="res://scenes/cooking/cookie_closeup.tscn" id="scene"]

[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("roll")
title = "Roll the pastry thin"
hint = "Hold [grip] and roll the pin across the dough with [stick]. It stretches the way you roll: fill the dashed square."

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("cut")
title = "Cut two rectangles"
hint = "Move the cutter with [stick] and press [button] to cut. Keep them on the dough and apart!"
cookies = 2
piece_name = "Rectangles"
shape = "rect"
shape_size = Vector2(0.16, 0.1)
columns = 2
tray_spacing = Vector2(0.19, 0.13)

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("fill")
title = "Apple filling"
cue = "Fill!"
hint = "Hold [button] to spoon on the apples and let go when they fill the dashed outline, before they run over the edge."
spread = true
liquid_name = "Apples"
liquid_color = Color(0.86, 0.68, 0.32, 1)
line = 0.8
fill_seconds = 2
view_distance = 0.45
weight = 0.8

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("cover")
title = "Cover it"
cue = "Cover!"
hint = "Move the top over the filling with [stick] and press [button] to lay it down. Line it up!"
weight = 0.8

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("bake")
title = "Bake"
hint = "Press [button] to take it out when it's golden!"
weight = 1.3

[resource]
script = ExtResource("1_recipe")
display_name = "Apple Strudel"
pieces = 1
serve_on = ""
scene = ExtResource("scene")
steps = Array[ExtResource("2_action")]([SubResource("Resource_0"), SubResource("Resource_1"), SubResource("Resource_2"), SubResource("Resource_3"), SubResource("Resource_4")])
