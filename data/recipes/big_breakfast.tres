[gd_resource type="Resource" script_class="CookRecipe" format=3]

[ext_resource type="Script" path="res://scripts/cooking/cook_recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/cooking/cook_action.gd" id="2_action"]
[ext_resource type="Script" path="res://scripts/cooking/actions/heat_action.gd" id="heat"]
[ext_resource type="Script" path="res://scripts/cooking/actions/coat_action.gd" id="coat"]
[ext_resource type="Script" path="res://scripts/cooking/actions/lay_action.gd" id="lay"]
[ext_resource type="Script" path="res://scripts/cooking/actions/flip_action.gd" id="flip"]
[ext_resource type="Script" path="res://scripts/cooking/actions/place_action.gd" id="place"]
[ext_resource type="Script" path="res://scripts/cooking/actions/squeeze_action.gd" id="squeeze"]

[sub_resource type="Resource" id="Resource_heat"]
script = ExtResource("heat")
background = true
first_side_seconds = 8.0
second_side_seconds = 6.0
plating_pace = 0.35
perfect_to = 1.3
burnt_at = 1.9

[sub_resource type="Resource" id="Resource_butter"]
script = ExtResource("coat")
title = "Butter the griddle"
hint = "Hold [button] and move with [stick] to rub butter over the box on the griddle."
weight = 0.0
view_distance = 0.6
on_surface = "Griddle"
patch = Vector2(0.44, 0.2)
coat_color = Color(1, 0.88, 0.45, 0.6)
seconds = 2.5
blob_radius = 0.02
spacing = 0.01
target_coverage = 0.1
always_full = true
fade_seconds = 1.5

[sub_resource type="Resource" id="Resource_eggs"]
script = ExtResource("lay")
title = "Crack the eggs"
hint = "Press [button] to crack the egg, then move with [stick] to a spot in the box and press [button] again to open it there."
weight = 0.0
view_distance = 0.6
kind = "egg"
zone_size = Vector2(0.44, 0.2)
side_seconds = 20.0

[sub_resource type="Resource" id="Resource_bacon"]
script = ExtResource("lay")
title = "Lay the bacon"
hint = "Move with [stick] to a spot in the box and press [button] to lay a strip down, lengthways."
weight = 0.0
view_distance = 0.6
kind = "bacon"
zone_size = Vector2(0.44, 0.2)

[sub_resource type="Resource" id="Resource_flip"]
script = ExtResource("flip")
title = "Flip the bacon"
hint = "When \"Flip!\" pops up over a strip, press [button] on it to slide the spatula under, then [flick_up] to flip it. The eggs stay sunny side up."
view_distance = 0.6
only_kind = "bacon"

[sub_resource type="Resource" id="Resource_plate"]
script = ExtResource("place")
title = "Plate it"
hint = "When \"Plate it!\" pops up, press [button] on it: the spatula takes it to its spot on the plate."
weight = 0.0
carry = true
view_distance = 0.6
arrange = {
"bacon": [Vector3(-0.052, 0.028, -18), Vector3(0.052, 0.028, 18)],
"egg": [Vector3(-0.062, -0.052, 0), Vector3(0.062, -0.052, 0)]
}

[sub_resource type="Resource" id="Resource_toast"]
script = ExtResource("place")
title = "Toast nose"
hint = "Move the toast with [stick] and press [button] to set it in the ring, in the middle of the face."
weight = 0.5
view_distance = 0.45
from_surface = ""
item_size = Vector3(0.08, 0.012, 0.04)
item_color = Color(0.92, 0.7, 0.38, 1)
item_shape = "toast_half"
aim_at = true
aim = Vector2(0, -0.014)
perfect_offset = 0.01
worst_offset = 0.07

[sub_resource type="Resource" id="Resource_smile"]
script = ExtResource("squeeze")
title = "Ketchup smile"
hint = "Hold [button] and follow the dots with [stick] to squeeze a smile."
weight = 0.5
view_distance = 0.45
view_pitch = 78.0

[resource]
script = ExtResource("1_recipe")
display_name = "Big Breakfast"
pieces = 4
steps = Array[ExtResource("2_action")]([SubResource("Resource_heat"), SubResource("Resource_butter"), SubResource("Resource_eggs"), SubResource("Resource_bacon"), SubResource("Resource_flip"), SubResource("Resource_plate"), SubResource("Resource_toast"), SubResource("Resource_smile")])
