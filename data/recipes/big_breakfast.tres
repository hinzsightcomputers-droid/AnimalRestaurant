[gd_resource type="Resource" script_class="CookRecipe" format=3]

[ext_resource type="Script" path="res://scripts/cooking/cook_recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/cooking/cook_action.gd" id="2_action"]
[ext_resource type="Script" path="res://scripts/cooking/actions/heat_action.gd" id="heat"]
[ext_resource type="Script" path="res://scripts/cooking/actions/pour_action.gd" id="pour"]
[ext_resource type="Script" path="res://scripts/cooking/actions/flip_action.gd" id="flip"]
[ext_resource type="Script" path="res://scripts/cooking/actions/place_action.gd" id="place"]

[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("heat")
background = true

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("pour")
title = "Crack the eggs"
view_distance = 0.7
hint = "Aim with [stick] and hold [button] to pour. Let go when it fills the ring."
batter_color = Color(0.98, 0.97, 0.9, 1)

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("flip")
title = "Flip the eggs"
view_distance = 0.7
hint = "When \"Flip!\" pops up over one, press [button] on it to slide the spatula under, then [flick_up] to flip it."

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("place")
title = "Plate them"
hint = "When \"Plate it!\" pops up, press [button] on an egg to lift it on the spatula, then move over the plate and press [button] again."
weight = 0.0
carry = true
view_distance = 0.95

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("place")
title = "Bacon"
view_distance = 0.45
hint = "Move the bacon with [stick] and press [button] to lay it on top."
from_surface = ""
item_size = Vector3(0.1, 0.012, 0.03)
item_color = Color(0.72, 0.28, 0.2, 1)

[sub_resource type="Resource" id="Resource_5"]
script = ExtResource("place")
title = "Toast"
view_distance = 0.45
hint = "Move it with [stick] and press [button] to drop it on top."
from_surface = ""
item_size = Vector3(0.07, 0.014, 0.07)
item_color = Color(0.82, 0.58, 0.3, 1)
weight = 0.5

[resource]
script = ExtResource("1_recipe")
display_name = "Big Breakfast"
pieces = 2
steps = Array[ExtResource("2_action")]([SubResource("Resource_0"), SubResource("Resource_1"), SubResource("Resource_2"), SubResource("Resource_3"), SubResource("Resource_4"), SubResource("Resource_5")])
