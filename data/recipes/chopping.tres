[gd_resource type="Resource" script_class="CookRecipe" format=3]

[ext_resource type="Script" path="res://scripts/cooking/cook_recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/cooking/cook_action.gd" id="2_action"]
[ext_resource type="Script" path="res://scripts/cooking/actions/peel_action.gd" id="4_peel"]
[ext_resource type="Script" path="res://scripts/cooking/actions/chop_action.gd" id="3_chop"]

[sub_resource type="Resource" id="Resource_peel"]
script = ExtResource("4_peel")
title = "Peel"
hint = "Hold [grip] and drag the peeler along the carrot with [stick], left to right in one straight line. All four sides!"
weight = 0.5

[sub_resource type="Resource" id="Resource_chop"]
script = ExtResource("3_chop")
title = "Chop"
hint = "Press [button] on the beat. The knife moves along to the next cut by itself."

[resource]
script = ExtResource("1_recipe")
display_name = "Chopping"
pieces = 1
serve_on = "Board"
steps = Array[ExtResource("2_action")]([SubResource("Resource_peel"), SubResource("Resource_chop")])
