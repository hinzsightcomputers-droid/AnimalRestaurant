[gd_resource type="Resource" script_class="CookRecipe" format=3]

[ext_resource type="Script" path="res://scripts/cooking/cook_recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/cooking/cook_action.gd" id="2_action"]
[ext_resource type="Script" path="res://scripts/cooking/actions/heat_action.gd" id="heat"]
[ext_resource type="Script" path="res://scripts/cooking/actions/pour_action.gd" id="pour"]
[ext_resource type="Script" path="res://scripts/cooking/actions/flip_action.gd" id="flip"]
[ext_resource type="Script" path="res://scripts/cooking/actions/place_action.gd" id="place"]
[ext_resource type="Script" path="res://scripts/cooking/actions/drizzle_action.gd" id="drizzle"]

[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("heat")
background = true

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("pour")
title = "Pipe the dough"
lanes = true
thickness = 0.027
bottle_height = 0.1
target_radius = 0.13
most_over = 0.025
view_distance = 0.5
hint = "Pick a line with [stick] and hold [button] to pipe a churro along it. Let go at the end of the line."
batter_color = Color(0.85, 0.62, 0.36, 1)

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("flip")
title = "Fry: turn them"
view_distance = 0.5
hint = "When \"Flip!\" pops up over one, press [button] on it to slide the spatula under, then [flick_up] to flip it."

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("place")
title = "Plate them"
hint = "When \"Plate it!\" pops up, press [button] on one: the spatula slides under it and puts it on the plate."
weight = 0.0
carry = true
arrange = {
"churro": [Vector3(0, -0.042, 7), Vector3(0.004, 0, -3), Vector3(-0.003, 0.042, 5)]
}
view_distance = 0.95

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("drizzle")
title = "Chocolate"
kind = "chocolate"
flow_rate = 1.1e-05
view_distance = 0.36
view_pitch = 50.0
hint = "Hold [button] and move to drizzle chocolate over the top."
syrup_color = Color(0.24, 0.12, 0.06, 1)

[resource]
script = ExtResource("1_recipe")
display_name = "Churros"
pieces = 3
steps = Array[ExtResource("2_action")]([SubResource("Resource_0"), SubResource("Resource_1"), SubResource("Resource_2"), SubResource("Resource_3"), SubResource("Resource_4")])
