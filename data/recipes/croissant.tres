[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("roll")
title = "Roll a long rectangle"
hint = "Hold [grip] and roll the pin across the dough with [stick]. It stretches the way you roll: fill the dashed rectangle."
target_size = Vector2(0.2, 0.33)

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("dough_fold")
title = "Fold in thirds"
cue = "Fold!"
hint = "Press [button] on the dough, then [flick_up] to fold it over the way the arrow goes. Twice, like a letter."
weight = 0.5

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("dough_fold")
title = "Turn it"
cue = "Turn!"
hint = "Press [button] to give the dough a quarter turn."
turn_first = true
folds = 0
weight = 0

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("roll")
title = "Roll it out again"
hint = "Hold [grip] and roll the pin across the dough with [stick]. It stretches the way you roll: fill the dashed rectangle."
target_size = Vector2(0.2, 0.33)
use_sheet = true

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("dough_fold")
title = "Fold in thirds again"
cue = "Fold!"
hint = "Press [button] on the dough, then [flick_up] to fold it over the way the arrow goes. Twice, like a letter."
butter_streaks = true
weight = 0.5

[sub_resource type="Resource" id="Resource_5"]
script = ExtResource("roll")
title = "Roll it long and thin"
hint = "Hold [grip] and roll the pin across the dough with [stick]. It stretches the way you roll: fill the dashed rectangle."
target_size = Vector2(0.42, 0.2)
use_sheet = true

[sub_resource type="Resource" id="Resource_6"]
script = ExtResource("cut")
title = "Cut triangles"
hint = "Move the cutter with [stick] and press [button] to cut long triangles. Keep them on the dough and apart!"
cookies = 4
piece_name = "Triangles"
shape = "triangle"
shape_size = Vector2(0.085, 0.17)
columns = 4
tray_spacing = Vector2(0.1, 0.13)

[sub_resource type="Resource" id="Resource_7"]
script = ExtResource("trace")
title = "Roll them up"
cue = "Roll up!"
hint = "Hold [button] on the green ring and follow the arrow with [stick] to roll each one up from the wide end to the tip."
shape = "roll_up"

[sub_resource type="Resource" id="Resource_8"]
