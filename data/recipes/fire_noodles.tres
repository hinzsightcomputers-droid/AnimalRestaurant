[gd_resource type="Resource" script_class="CookRecipe" format=3]

[ext_resource type="Script" path="res://scripts/cooking/cook_recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/cooking/cook_action.gd" id="2_action"]
[ext_resource type="Script" path="res://scripts/cooking/actions/scrape_action.gd" id="scrape"]
[ext_resource type="Script" path="res://scripts/cooking/actions/stir_action.gd" id="stir"]
[ext_resource type="Script" path="res://scripts/cooking/actions/season_action.gd" id="season"]
[ext_resource type="PackedScene" path="res://scenes/cooking/soup_closeup.tscn" id="scene"]

[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("scrape")
title = "Noodles in"
hint = "Hold [grip] on the board and carry it to the pot. Then hold [grip] and push the knife to sweep everything in. Gently, or it splashes!"
weight = 0.5
piece_radius = 0.02
piece_thickness = 0.008

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("stir")
title = "Toss them"
hint = "Roll [stick] round and round to stir it (with the mouse, hold [grip] and circle the pot). Not too slow, not too fast!"
turns = 5
fast_speed = 1.9

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("season")
title = "Chili oil"
hint = "Move it over the pot with [stick] and press [button] to shake. Stop when the meter is in the green."
seasoning = "Chili"
flake_color = Color(0.85, 0.15, 0.05, 1)
cap_color = Color(0.7, 0.12, 0.08, 1)
band = Vector2(0.6, 0.8)

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("season")
title = "Garnish: green onion"
hint = "Now the green onion. Shake [button] over the pot until the meter is in the green, then stop."
seasoning = "Green onion"
flake_color = Color(0.4, 0.75, 0.3, 1)
cap_color = Color(0.3, 0.55, 0.3, 1)
band = Vector2(0.35, 0.55)
weight = 0.5

[resource]
script = ExtResource("1_recipe")
display_name = "Fire Noodles"
pieces = 1
serve_on = ""
scene = ExtResource("scene")
steps = Array[ExtResource("2_action")]([SubResource("Resource_0"), SubResource("Resource_1"), SubResource("Resource_2"), SubResource("Resource_3")])
