[gd_resource type="Resource" script_class="CookRecipe" format=3]

[ext_resource type="Script" path="res://scripts/cooking/cook_recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/cooking/cook_action.gd" id="2_action"]
[ext_resource type="Script" path="res://scripts/cooking/actions/scrape_action.gd" id="3_scrape"]
[ext_resource type="Script" path="res://scripts/cooking/actions/stir_action.gd" id="4_stir"]
[ext_resource type="Script" path="res://scripts/cooking/actions/season_action.gd" id="5_season"]
[ext_resource type="PackedScene" path="res://scenes/cooking/soup_closeup.tscn" id="6_scene"]

[sub_resource type="Resource" id="Resource_scrape"]
script = ExtResource("3_scrape")
title = "Into the pot"
hint = "Hold [grip] on the board and carry it to the pot. Then hold [grip] and push the knife to sweep the fish in. Gently, or it splashes!"
weight = 0.5
piece_radius = 0.022
piece_thickness = 0.014

[sub_resource type="Resource" id="Resource_stir"]
script = ExtResource("4_stir")
title = "Stir"
hint = "Roll [stick] round counter-clockwise, the way the arrow goes, to whisk it (with the mouse, hold [grip] and circle the pot). Don't stop stirring!"
turns = 6.0

[sub_resource type="Resource" id="Resource_salt"]
script = ExtResource("5_season")
title = "Season: salt"
hint = "Move the shaker over the pot with [stick] and press [button] to shake. Stop when the meter is in the green."
weight = 0.5

[sub_resource type="Resource" id="Resource_herbs"]
script = ExtResource("5_season")
title = "Season: herbs"
hint = "Now the herbs. Shake [button] over the pot until the meter is in the green, then stop."
weight = 0.5
seasoning = "Herbs"
flake_color = Color(0.35, 0.65, 0.25, 1)
cap_color = Color(0.3, 0.55, 0.3, 1)
band = Vector2(0.4, 0.6)

[resource]
script = ExtResource("1_recipe")
display_name = "Fish Stew"
pieces = 1
serve_on = ""
scene = ExtResource("6_scene")
steps = Array[ExtResource("2_action")]([SubResource("Resource_scrape"), SubResource("Resource_stir"), SubResource("Resource_salt"), SubResource("Resource_herbs")])
