[gd_resource type="Resource" script_class="CookRecipe" format=3]

[ext_resource type="Script" path="res://scripts/cooking/cook_recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/cooking/cook_action.gd" id="2_action"]
[ext_resource type="Script" path="res://scripts/cooking/actions/mash_action.gd" id="mash"]
[ext_resource type="Script" path="res://scripts/cooking/actions/scrape_action.gd" id="3_scrape"]
[ext_resource type="Script" path="res://scripts/cooking/actions/stir_action.gd" id="4_stir"]
[ext_resource type="Script" path="res://scripts/cooking/actions/season_action.gd" id="5_season"]
[ext_resource type="Script" path="res://scripts/cooking/actions/ladle_action.gd" id="ladle"]
[ext_resource type="PackedScene" path="res://scenes/cooking/veg_soup_closeup.tscn" id="6_scene"]

[sub_resource type="Resource" id="Resource_mash"]
script = ExtResource("mash")
title = "Crush the tomatoes"
cue = "Squish!"
hint = "Move the masher over a tomato with [stick] and press [button] to crush it. A few presses each, and don't miss!"
weight = 0.5

[sub_resource type="Resource" id="Resource_scrape"]
script = ExtResource("3_scrape")
title = "Fish in"
view_distance = 0.6
view_pitch = 56
hint = "Hold [grip] on the board and carry it to the pot. Then hold [grip] and push the knife to sweep the fish in. Gently, or it splashes!"
weight = 0.4
piece_radius = 0.022
piece_thickness = 0.014

[sub_resource type="Resource" id="Resource_stir"]
script = ExtResource("4_stir")
title = "Stir gently"
view_distance = 0.48
view_pitch = 60
hint = "Roll [stick] round slowly, the way the arrow goes, to stir the fish through the sauce. Too fast and the fish falls apart!"
weight = 0.6
turns = 3.0
slow_speed = 0.15
fast_speed = 1.1
tool = "spoon"
crumbles = true

[sub_resource type="Resource" id="Resource_herbs"]
script = ExtResource("5_season")
title = "Herbs on top"
view_distance = 0.56
view_pitch = 58
hint = "Shake the herbs over the pot with [button] until the meter is in the green, then stop."
weight = 0.4
seasoning = "Herbs"
flake_color = Color(0.35, 0.65, 0.25, 1)
cap_color = Color(0.3, 0.55, 0.3, 1)
band = Vector2(0.4, 0.6)

[sub_resource type="Resource" id="Resource_ladle"]
script = ExtResource("ladle")
title = "Ladle it out"
view_distance = 0.58
view_pitch = 56
hint = "Press [button] over the pot to scoop, then move to the bowl with [stick] and press [button] over its middle to pour. Three ladles fill it."
weight = 0.5

[resource]
script = ExtResource("1_recipe")
display_name = "Fish Stew"
pieces = 1
serve_on = ""
scene = ExtResource("6_scene")
steps = Array[ExtResource("2_action")]([SubResource("Resource_mash"), SubResource("Resource_scrape"), SubResource("Resource_stir"), SubResource("Resource_herbs"), SubResource("Resource_ladle")])
