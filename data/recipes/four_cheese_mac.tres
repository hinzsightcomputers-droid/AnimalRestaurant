[gd_resource type="Resource" script_class="CookRecipe" format=3]

[ext_resource type="Script" path="res://scripts/cooking/cook_recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/cooking/cook_action.gd" id="2_action"]
[ext_resource type="Script" path="res://scripts/cooking/actions/boil_action.gd" id="boil"]
[ext_resource type="Script" path="res://scripts/cooking/actions/grate_action.gd" id="grate"]
[ext_resource type="Script" path="res://scripts/cooking/actions/drain_action.gd" id="drain"]
[ext_resource type="Script" path="res://scripts/cooking/actions/scrape_action.gd" id="scrape"]
[ext_resource type="Script" path="res://scripts/cooking/actions/stir_action.gd" id="stir"]
[ext_resource type="PackedScene" path="res://scenes/cooking/mac_closeup.tscn" id="scene"]

[sub_resource type="Resource" id="Resource_boil"]
script = ExtResource("boil")
title = "Boil the pasta"
hint = "Move the bowl over the pot with [stick] and press [button] to tip the macaroni into the boiling water."
view_distance = 0.75

[sub_resource type="Resource" id="Resource_grate"]
script = ExtResource("grate")
title = "Grate the cheese"
cue = "Four cheeses!"
hint = "While the pasta boils: hold [grip] and rub up and down with [stick] on the grater. Let go when the meter's in the green, before the rind!"
view_distance = 0.85

[sub_resource type="Resource" id="Resource_drain"]
script = ExtResource("drain")
title = "Drain it"
hint = "When the meter's in the green, press [button] to take the pot off. Let go, then hold [button] to pour the water out, and let go again at the line."
weight = 0.5
view_distance = 0.7
view_pitch = 52.0

[sub_resource type="Resource" id="Resource_scrape"]
script = ExtResource("scrape")
title = "Cheese in!"
hint = "Hold [grip] on the board and carry it to the pot. Then hold [grip] and push the knife to sweep all the cheese in. Gently, or it splashes!"
weight = 0.5
view_distance = 0.8

[sub_resource type="Resource" id="Resource_fold"]
script = ExtResource("stir")
title = "Fold in the cheese"
hint = "Roll [stick] round counter-clockwise, the way the arrow goes, to fold it till it's melted (with the mouse, hold [grip] and circle the pot)."
weight = 0.7
view_distance = 0.7
turns = 5.0
melt = true
coat = true
tint_to = Color(0.98, 0.76, 0.28, 1)
tool = "spatula"

[resource]
script = ExtResource("1_recipe")
display_name = "Four-Cheese Mac"
pieces = 1
serve_on = ""
scene = ExtResource("scene")
steps = Array[ExtResource("2_action")]([SubResource("Resource_boil"), SubResource("Resource_grate"), SubResource("Resource_drain"), SubResource("Resource_scrape"), SubResource("Resource_fold")])
