[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("heat")
background = true

[sub_resource type="Resource" id="Resource_rice"]
script = ExtResource("rice_in")
title = "Rice in the pot"
hint = "Move the cup over the pot with [stick] and press [button] to tip the rice in."

[sub_resource type="Resource" id="Resource_water"]
script = ExtResource("fill")
title = "Water to the line"
hint = "Hold [button] to pour the water and let go at the line: too much and the rice goes mushy."
weight = 0.4
view_distance = 0.45
into = "RicePot"
liquid_name = "Water"
liquid_color = Color(0.7, 0.86, 0.95, 0.7)
line = 0.6
pour_height = 0.12

[sub_resource type="Resource" id="Resource_cook"]
script = ExtResource("cook_rice")
title = "Cook the rice"
cue = "Simmer..."
hint = "The water soaks in as it simmers. Press [button] to turn the heat off when the meter's in the green: fluffy, not crunchy or mushy."
weight = 0.7
view_distance = 0.45
rise_seconds = 3.0
band = Vector2(0.62, 0.8)
meter_offset = Vector3(0, 0.02, 0.13)
meter_length = 0.22

[sub_resource type="Resource" id="Resource_ketchup_rice"]
script = ExtResource("stir")
title = "Ketchup rice"
hint = "Roll [stick] round counter-clockwise, the way the arrow goes, to stir the ketchup through the rice."
weight = 0.4
view_distance = 0.45
in_surface = "RicePot"
turns = 3.0
coat = true
tint_to = Color(0.86, 0.36, 0.22, 1)
tool = "spoon"

[sub_resource type="Resource" id="Resource_mound"]
script = ExtResource("place")
from_surface = ""
title = "Rice onto the plate"
view_distance = 0.4
view_pitch = 52.0
hint = "Move the rice over the plate with [stick] and press [button] to turn it out in a neat mound in the middle."
weight = 0.4
item_shape = "rice_mound"
item_size = Vector3(0.21, 0.034, 0.12)
aim_at = true
item_color = Color(0.86, 0.38, 0.24, 1)

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("pour")
title = "Pour the eggs"
zone_size = Vector2(0.84, 0.36)
hint = "Aim with [stick] and hold [button] to pour. Let go when it fills the ring."
view_distance = 0.58
batter_color = Color(0.98, 0.84, 0.32, 1)
done_color = Color(1, 0.8, 0.22, 1)

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("fold")
title = "Fold it in half"
hint = "When \"Fold!\" pops up, press [button] on it to slide the spatula under, then [flick_up] to fold it over."
view_distance = 0.58

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("flip")
title = "Flip it"
hint = "When \"Flip!\" pops up, press [button] on it to slide the spatula under, then [flick_up] to flip it."
view_distance = 0.58

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("place")
title = "Over the rice"
hint = "When \"Plate it!\" pops up, press [button] on it: the spatula slides under it and puts it on the plate."
weight = 0.0
carry = true
view_distance = 0.95

[sub_resource type="Resource" id="Resource_5"]
script = ExtResource("drizzle")
title = "Draw with ketchup"
kind = "ketchup"
flow_rate = 6e-06
line_radius = 0.009
hint = "Hold [button] and draw one squiggly line of ketchup over it, then let go."
view_distance = 0.36
view_pitch = 50.0
syrup_color = Color(0.8, 0.1, 0.06, 1)
target_coverage = 0.12
one_stroke = true

[resource]
script = ExtResource("1_recipe")
display_name = "Omurice"
pieces = 1
