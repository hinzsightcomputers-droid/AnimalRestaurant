[sub_resource type="Resource" id="Resource_n6xqa"]
script = ExtResource("3_47a2j")
background = true

[sub_resource type="Resource" id="Resource_milk"]
script = ExtResource("8_fill")
title = "Milk in"
hint = "Hold [button] to pour the milk and let go at the white line."
weight = 0.5
view_distance = 0.55
into = "MixBowl"
line = 0.55

[sub_resource type="Resource" id="Resource_whisk"]
script = ExtResource("9_stir")
title = "Whisk the batter"
hint = "Roll [stick] round counter-clockwise, the way the arrow goes, to whisk out the lumps (with the mouse, hold [grip] and circle the bowl)."
weight = 0.5
view_distance = 0.55
in_surface = "MixBowl"
turns = 4.0
tint_to = Color(0.96, 0.88, 0.66, 1)
lumps = 8

[sub_resource type="Resource" id="Resource_pd7ri"]
script = ExtResource("4_qrhs7")
title = "Pour the batter"
view_distance = 0.7
hint = "Aim with [stick] and hold [button] to pour. Let go when it fills the ring."

[sub_resource type="Resource" id="Resource_fortm"]
script = ExtResource("5_gyj60")
title = "Flip them"
view_distance = 0.7
hint = "When \"Flip!\" pops up over a pancake, press [button] on it to slide the spatula under, then [flick_up] to flip it."

[sub_resource type="Resource" id="Resource_uysvd"]
script = ExtResource("6_a77i3")
title = "Plate them"
hint = "When \"Plate it!\" pops up, press [button] on a pancake: the spatula slides under it and puts it on the plate."
weight = 0.0
carry = true
view_distance = 0.95

[sub_resource type="Resource" id="Resource_ky8i2"]
script = ExtResource("6_a77i3")
from_surface = ""
melt_seconds = 2.0
title = "Butter"
view_distance = 0.45
hint = "Move the butter with [stick] and press [button] to drop it on top."
weight = 0.5

[sub_resource type="Resource" id="Resource_y5gt6"]
script = ExtResource("7_ju8yr")
title = "Syrup"
view_distance = 0.45
hint = "Hold [button] and move to drizzle syrup over the top."

[resource]
script = ExtResource("1_wehfw")
display_name = "Pancakes"
