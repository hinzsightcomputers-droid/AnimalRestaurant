[ext_resource type="Script" path="res://scripts/cooking/cook_action.gd" id="2_action"]
[ext_resource type="Script" path="res://scripts/cooking/actions/wipe_action.gd" id="3_wipe"]

[sub_resource type="Resource" id="Resource_wipe"]
script = ExtResource("3_wipe")
