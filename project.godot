; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dinner Time"
run/main_scene="res://scenes/intro/logo_splash.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/AnimalRestaurant"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.png"

[autoload]

InputSetup="*res://scripts/autoload/input_setup.gd"
Settings="*res://scripts/autoload/settings.gd"
GameData="*res://scripts/autoload/game_data.gd"
GameEvents="*res://scripts/autoload/game_events.gd"
Accounts="*res://scripts/autoload/accounts.gd"
DayCycle="*res://scripts/autoload/day_cycle.gd"
GameState="*res://scripts/autoload/game_state.gd"
Music="*res://scripts/autoload/music.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
